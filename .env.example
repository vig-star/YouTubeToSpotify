# Copy to .env at the repository root. Never commit real credentials.
# Register these exact callback URLs with each provider.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/callbackGoogle
YOUTUBE_API_KEY=
