{
  "name": "youtubetospotify",
  "version": "1.0.0",
  "description": "A React and Express playlist-transfer prototype connecting Spotify and YouTube.",
  "main": "server/server.js",
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.17.3",
    "express-session": "^1.17.2",
    "json": "^11.0.0",
    "request": "^2.88.2"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.js",
    "client": "npm --prefix client start",
    "build": "npm --prefix client run build",
    "test": "npm --prefix client test -- --watchAll=false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vig-star/YouTubeToSpotify.git"
  },
